{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arkan-al-masar",
  "main": "worker.ts",
  "triggers": { "crons": ["0 * * * *"] },
  "workers_dev": true,
  "routes": [
    { "pattern": "arkanalmasar.sa", "custom_domain": true },
    { "pattern": "www.arkanalmasar.sa", "custom_domain": true }
  ],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arkan-al-masar-db",
      "database_id": "22c7a3e7-c16f-4fe3-a2bd-f0214eb53ab5",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "BOOKING_MODE": "demo",
    "VAPID_SUBJECT": "https://arkanalmasar.sa"
  }
}
